{
  "name": "sidewalk-senate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node --check src/server.mjs && node --check src/core.mjs && node --check src/model.mjs",
    "walk": "node src/walk.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "setup": "node scripts/local.mjs --setup",
    "doctor": "node scripts/local.mjs --check",
    "local": "node scripts/local.mjs",
    "simulate": "node scripts/simulate.mjs",
    "simulate:real": "node scripts/simulate.mjs --real"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^26.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
